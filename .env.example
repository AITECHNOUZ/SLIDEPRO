# ── Telegram ─────────────────────────────────────────
BOT_TOKEN=
ADMIN_IDS=123456789
PUBLIC_URL=
DELIVERY_CHANNEL_ID=

# ── LLM: faqat Claude API va OpenAI API ───────────────
# Kamida bittasi kerak. LLM_PROVIDER (admin panelda ham o'zgartiriladi):
#   anthropic     — faqat Claude
#   openai        — faqat OpenAI
#   claude_openai — avval arzon OpenAI modeli, 2 marta xato qilsa Claude (asosiy)
#   claude_claude — avval arzon Claude (Haiku), 2 marta xato qilsa Claude asosiy (Sonnet)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CHEAP_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_CHEAP_MODEL=gpt-5-mini
LLM_PROVIDER=anthropic
# Mustaqil ish uchun alohida provayder (bo'sh = taqdimot bilan bir xil)
MUSTAQIL_LLM_PROVIDER=
# Ixtiyoriy: gpt-5/o-seriya uchun fikrlash darajasi (minimal|low|medium|high)
OPENAI_REASONING_EFFORT=
# Ixtiyoriy: so'rov timeouti (ms) va retry soni
LLM_TIMEOUT_MS=
LLM_RETRIES=4
# 1 bo'lsa faqat tanlangan provayder; aks holda Claude yiqilsa OpenAI kaliti zaxira sifatida ishlatiladi
LLM_STRICT_PROVIDER=
SLIDEPRO_LLM_CONCURRENCY=3
# ── Claude limitlari (Tier 1 uchun moslangan) ─────────────
# So'rovlar limitga sig'adigan qilib navbatga qo'yiladi; haqiqiy limitlar javob sarlavhalaridan
# avtomatik o'qiladi (balans oshib Tier 2+ bo'lsa o'zi tezlashadi). O'chirish: ANTHROPIC_RATE_LIMITER=off
ANTHROPIC_RATE_LIMITER=
ANTHROPIC_RPM=45
ANTHROPIC_ITPM=27000
ANTHROPIC_OTPM=7500
# Asosiy model band (529) bo'lsa zaxira model (o'chirish: off)
ANTHROPIC_FALLBACK_MODEL=claude-haiku-5-5
# Bir vaqtda tayyorlanadigan mustaqil ishlar soni (Tier 1 da 1 tavsiya etiladi)
MAX_PARALLEL_MUSTAQIL=1

# ── Mustaqil ish ─────────────────────────────────────
# So'ralgan sahifaga moslash (LibreOffice kerak). production'da standart yoqilgan.
SLIDEPRO_PAGE_FIT=1
# Grafik dvigateli: matplotlib (GOST, standart) | svg (zaxira)
SLIDEPRO_CHART_ENGINE=
# Chizmalardagi shrift (GOST chizma qoidasi: DejaVu Sans)
SLIDEPRO_FIGURE_FONT=DejaVu Sans

# ── Narx va to'lov ───────────────────────────────────
PRICE_PER_SLIDE=5000
CURRENCY=so'm
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=F.I.SH
MANUAL_ENABLED=true
CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_KEY=

DB_PATH=./data/bot.sqlite
PORT=3000

# Adabiyotlarni Crossref orqali tekshirish (production'da yoqilgan)
SLIDEPRO_VERIFY_REFS=1
CROSSREF_MAILTO=

# Zaxira modellar: asosiy model ketma-ket 3 marta javob bermasa (API xatosi yoki format buzilgan) shu tartibda o'tiladi.
# Bo'sh — standart: boshqa provayder → claude-opus-5-5 → gpt-5 (kaliti borlari). O'chirish: off. Admin paneldan ham sozlanadi.
# LLM_FALLBACK_MODELS=openai:gpt-5, anthropic:claude-opus-5-5
# Bir vaqtda tayyorlanadigan taqdimotlar soni (qolganlari navbatda)
# MAX_PARALLEL_TAQDIMOT=3
# Tayyor fayllar diskda necha kun saqlanadi (Telegram'da file_id orqali saqlanib qoladi)
# OUTPUT_KEEP_DAYS=3

# DeepSeek (OpenAI bilan mos API). Modellar: deepseek-v4-pro (asosiy), deepseek-flash (arzon)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_CHEAP_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GLM / Z.ai (OpenAI bilan mos API). Modellar: glm-5.3, glm-5.3-flashx, glm-5.3-flash, glm-4.7-flash (bepul)
# ZAI_API_KEY=...
# ZAI_MODEL=glm-5.3
# ZAI_CHEAP_MODEL=glm-5.3-flash
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_THINKING=disabled
# LLM_PROVIDER qiymatlari: anthropic | openai | deepseek | zai | claude_openai | claude_claude | claude_deepseek | claude_glm
